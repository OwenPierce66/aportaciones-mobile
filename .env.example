# ─── Aportaciones Mobile — Variables de entorno ────────────────────────────────────
# Copia este archivo a .env y ajusta los valores para tu entorno.
# NUNCA subas .env a git — ya está en .gitignore.
# ─────────────────────────────────────────────────────────────────────────────

# IP local de tu máquina (para acceso desde dispositivo físico/emulador)
# En web siempre se usa localhost, esta IP solo aplica para iOS/Android.
LOCAL_IP=192.168.0.108

# Puerto del backend (Nginx proxy)
API_PORT=8001

# URL pública opcional del backend (sin ella, producción usa Render y desarrollo usa LOCAL_IP)
# Ejemplo: API_URL=https://aportaciones-backend.onrender.com/api/
API_URL=

# DSN de Sentry para crash reporting (obtener en https://sentry.io → Settings → Projects → Client Keys)
# Dejar vacío para deshabilitar Sentry en local.
SENTRY_DSN=

# Clave de Google Maps para el Mapa (Maps SDK for Android / iOS).
GOOGLE_MAPS_API_KEY=

# Entrar con Google: IDs de cliente OAuth (Google Cloud > APIs y servicios > Credenciales).
# - Web: orígenes de JavaScript y URI de redirección autorizados http://localhost:19006
#   (y el dominio donde se publique la web).
# - Android: paquete com.aportaciones.app y la huella SHA-1 del certificado que firma el APK.
# Sin el ID de una plataforma, ahí no sale el botón. El backend necesita los mismos IDs en su
# GOOGLE_CLIENT_IDS. En Android/iOS hace falta compilar la app de nuevo.
GOOGLE_WEB_CLIENT_ID=
GOOGLE_ANDROID_CLIENT_ID=
GOOGLE_IOS_CLIENT_ID=
